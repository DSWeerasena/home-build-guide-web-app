# House Build Guide website — copy to .env.local for local development (never commit the real file).
# On Vercel, enter these under: Project → Settings → Environment Variables.
#
# These are PUBLIC browser settings. Never put the Firebase Admin private key or any server secret here.
# Leave the Firebase values empty to run in "local mode" (data saved only in this browser, demo login).

# The Express API. Local: http://localhost:5000   Production: your Render URL, e.g. https://house-build-guide-api.onrender.com
VITE_API_URL=

# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration (Config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
