# House Build Guide API — copy to server/.env for local development (never commit the real .env).
# On Render, enter these under: Service → Environment. Do not paste real values into this file.

# "development" locally, "production" on Render.
NODE_ENV=development

# Render sets PORT automatically; 5000 is used locally when empty.
PORT=5000

# Website(s) allowed to call the API (CORS). Comma-separate several, no trailing slash.
# Production example: https://house-build-guide.vercel.app
FRONTEND_URL=http://localhost:5173

# From Firebase Console → Project settings → Service accounts → Generate new private key (JSON file).
# project_id
FIREBASE_PROJECT_ID=
# client_email
FIREBASE_CLIENT_EMAIL=
# private_key — keep it on ONE line with the \n sequences exactly as in the JSON file, wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Firebase Console → Storage → the bucket name shown at the top (without gs://), e.g. your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=
