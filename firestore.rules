rules_version = '2';

// All writes go through the House Build Guide API (Firebase Admin SDK), which bypasses these rules and
// checks ownership itself. Browsers may only read their own records directly, and may never write.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsProject(projectId) {
      return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;

      match /calculations/{calculationId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
      match /plans/{planId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
